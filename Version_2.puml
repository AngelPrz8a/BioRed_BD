@startuml
!theme plain
hide circle
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 70
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

entity "etiquetas" as etiquetas {
  * id_etiqueta <<PK>>
  --
  nombre
  estado
}

entity "usuario_etiquetas" as usuario_etiquetas {
  * id_usuario <<PK,FK>>
  * id_etiqueta <<PK,FK>>
  --
  asignado_por <<FK>>
  fecha_asignacion
}

entity "usuarios" as usuarios {
  * id_usuario <<PK>>
  --
  nombre
  correo <<UK>>
  contrasena_hash
  rol_global
  estado_cuenta
  fecha_registro
}

entity "grupo_usuarios" as grupo_usuarios {
  * id_grupo_usuarios <<PK>>
  --
  id_usuario <<FK>>
  id_grupo <<FK>>
  id_solicitud_origen <<FK>>
  estado
  rol_grupo
  fecha_ingreso
  fecha_modificacion
  --
  UK (id_usuario, id_grupo)
}

entity "grupos" as grupos {
  * id_grupo <<PK>>
  --
  nombre <<UK>>
  descripcion
  visibilidad
  fecha_creacion
}

entity "auditorias" as auditorias {
  * id_auditoria <<PK>>
  --
  entidad
  entidad_id
  accion
  campo
  valor_anterior
  valor_nuevo
  usuario_id
  id_grupo_contexto
  fecha
}

entity "solicitudes" as solicitudes {
  * id_solicitud <<PK>>
  --
  id_solicitante <<FK>>
  id_responsable <<FK>>
  tipo
  id_modulo <<FK>>
  id_grupo <<FK>>
  rol_solicitado
  nivel_acceso_solicitado
  estado
  fecha_creacion
  fecha_resolucion
  justificacion_solicitante
  respuesta_resolucion
}

entity "accesos" as accesos {
  * id_acceso <<PK>>
  --
  id_modulo <<FK>>
  id_usuario <<FK>>
  id_solicitud <<FK,UK>>
  nivel_acceso
  estado
  concedido_por <<FK>>
  fecha_concesion
  fecha_expiracion
  revocado_por <<FK>>
  fecha_revocacion
  motivo_revocacion
}

entity "visualizacion" as visualizacion {
  * id_visualizacion <<PK>>
  --
  id_sensor <<FK>>
  id_usuario <<FK>>
  tipo
  configuracion
  fecha_creacion
  fecha_modificacion
}

entity "sensores" as sensores {
  * id_sensor <<PK>>
  --
  id_modulo <<FK>>
  tipo
}

entity "modulos" as modulos {
  * id_modulo <<PK>>
  --
  id_propietario <<FK>>
  id_grupo <<FK>>
  visibilidad
  fecha_modificacion
  modificado_por <<FK>>
}

note bottom of usuarios
  rol_global: administrador | usuario
  (alcance: toda la plataforma)
end note

note bottom of grupo_usuarios
  rol_grupo: miembro | coordinador
  (alcance: solo el id_grupo de la fila)
end note

note bottom of modulos
  visibilidad: publico | identificados |
  grupo | privado
  (grupo exige id_grupo NOT NULL)
end note

note bottom of auditorias
  id_grupo_contexto: copia del grupo al
  momento del cambio (sin FK, se conserva
  aunque el recurso cambie de grupo o se elimine)
end note

' ===== Fila superior =====
etiquetas         "1:*" -- "1:1" usuario_etiquetas
usuario_etiquetas "1:1" -- "1:*" usuarios
usuarios          "1:*" -- "1:1" grupo_usuarios
grupo_usuarios    "1:1" -- "1:*" grupos

' ===== Fila inferior =====
visualizacion "1:1" -- "1:*" sensores
sensores      "1:*" -- "1:1" modulos

' ===== Conexiones entre filas =====
usuarios "1:*" -down- "1:1" solicitudes
usuarios "1:*" -down- "1:1" visualizacion
usuarios "1:*" -down- "1:1" modulos
grupos   "1:*" -down- "1:1" modulos

' ===== Solicitudes y accesos concedidos =====
solicitudes "1:*" -- "0:1" modulos
solicitudes "1:*" -- "0:1" grupos
solicitudes "1:1" -- "0:1" accesos
solicitudes "1:1" -- "0:1" grupo_usuarios
usuarios    "1:*" -- "1:1" accesos
modulos     "1:*" -- "1:1" accesos

' Orden de la fila inferior (enlaces invisibles)
auditorias -[hidden]right- solicitudes
solicitudes -[hidden]right- visualizacion
@enduml
